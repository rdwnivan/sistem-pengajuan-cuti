# --- Wajib ---
# Database PostgreSQL (Neon / Supabase / Railway). Produksi WAJIB memakai Postgres.
DATABASE_URL="postgresql://user:pass@host:5432/cuti?sslmode=require"

# Token store PUBLIC lama: hanya untuk migrasi/pencabutan URL lampiran lama.
BLOB_READ_WRITE_TOKEN=""
# Token store dengan access PRIVATE; wajib untuk upload di Vercel.
# Lokal/CI tanpa token: .private/uploads/, hanya lewat API berotorisasi.
BLOB_PRIVATE_READ_WRITE_TOKEN=""

# --- Cron / pengingat otomatis ---
# Dipakai endpoint /api/cron. Wajib acak, minimal 32 karakter.
CRON_SECRET="isi-string-acak-min-32-karakter"

# --- Web Push Notification ---
# Generate: node -e "const w=require('web-push');console.log(JSON.stringify(w.generateVAPIDKeys(),null,2))"
# Isi keduanya agar notifikasi browser aktif. Kosong = fitur nonaktif (app tetap jalan normal).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# --- Opsional ---
# Token Fonnte untuk WhatsApp. Kosong = notifikasi WA hanya dicatat di log server.
FONNTE_TOKEN=""

# Set true HANYA sekali untuk mengisi data awal di database kosong.
# db:seed akan menolak jalan di production tanpa ini (mencegah data terhapus).
SEED_FORCE=""
