generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  nama         String
  email        String   @unique
  passwordHash String
  role         String   @default("KARYAWAN")
  jabatan      String?
  noHp         String?
  tglMasuk     DateTime @default(now())
  statusAktif  Boolean  @default(true)
  atasanId     String?
  atasan       User?    @relation("AtasanBawahan", fields: [atasanId], references: [id], onDelete: SetNull)
  bawahan      User[]   @relation("AtasanBawahan")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  pengajuan    Pengajuan[] @relation("Pemohon")
  approvals    Pengajuan[] @relation("ApproverSaatIni")
  audit        AuditLog[]
  kuota        Kuota[]
  delegasiDari Delegasi[] @relation("DelegasiDari")
  delegasiKe   Delegasi[] @relation("DelegasiKe")
  sesi         Sesi[]
   notifikasi   Notifikasi[]
   gajiPokok    Int?
   tunjanganTetap Int?
   slipGaji     SlipGaji[]
   laporanOwn   LaporanLapangan[] @relation("LaporanPembuat")
   laporanApprovals LaporanLapangan[] @relation("LaporanApprover")
    pushSubs     PushSubscription[]
    gajiPerubahanTarget   GajiPerubahan[] @relation("GajiPerubahanTarget")
    gajiPerubahanPengaju  GajiPerubahan[] @relation("GajiPerubahanPengaju")
    gajiPerubahanApprover GajiPerubahan[] @relation("GajiPerubahanApprover")
    gajiPerubahanPemutus  GajiPerubahan[] @relation("GajiPerubahanPemutus")
  }

model GajiPerubahan {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation("GajiPerubahanTarget", fields: [userId], references: [id], onDelete: Cascade)
  gajiPokokLama      Int      @default(0)
  tunjanganTetapLama Int      @default(0)
  gajiPokokBaru      Int
  tunjanganTetapBaru Int
  alasan             String
  status             String   @default("MENUNGGU")
  pengajuId          String
  pengaju            User     @relation("GajiPerubahanPengaju", fields: [pengajuId], references: [id], onDelete: Restrict)
  approverId         String
  approver           User     @relation("GajiPerubahanApprover", fields: [approverId], references: [id], onDelete: Restrict)
  diputuskanOlehId   String?
  diputuskanOleh     User?    @relation("GajiPerubahanPemutus", fields: [diputuskanOlehId], references: [id], onDelete: SetNull)
  catatan            String?
  decidedAt          DateTime?
  createdAt          DateTime @default(now())
  @@index([status])
  @@index([approverId, status])
  @@index([userId, createdAt])
}

model SlipGaji {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tahun       Int
  bulan       Int
  gajiPokok   Int
  tunjangan   Int      @default(0)
  potongan    Int      @default(0)
  gajiBersih  Int
  catatan     String?
  status      String   @default("TERBIT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([userId, tahun, bulan])
  @@index([tahun, bulan])
}

model LaporanLapangan {
  id             String   @id @default(cuid())
  pembuatId      String
  pembuat        User     @relation("LaporanPembuat", fields: [pembuatId], references: [id], onDelete: Cascade)
  approverId     String?
  approver       User?    @relation("LaporanApprover", fields: [approverId], references: [id], onDelete: SetNull)
  tglLaporan     DateTime
  lokasi         String
  shift          String?
  judul          String
  isi            String
  lampiranPath   String?
  status         String   @default("DRAFT")
  catatanApprover String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  riwayat        AuditLog[]
  notifikasi     Notifikasi[]
  @@index([approverId, status])
  @@index([pembuatId, createdAt])
}

model JenisCuti {
  id                   String @id @default(cuid())
  nama                 String @unique
  kuota                Int    @default(12)
  memotongKuotaTahunan Boolean @default(true)
  lampiranWajib        Boolean @default(false)
  lampiranWajibJikaLebihDari Int?
  minHariSebelum       Int    @default(3)
  butuhMasaKerjaBulan  Int    @default(0)
  aktif                Boolean @default(true)
  pengajuan Pengajuan[]
  daftarKuota Kuota[]
}

model HariLibur {
  id         String   @id @default(cuid())
  tanggal    DateTime @unique
  keterangan String
}

model Pengajuan {
  id              String     @id @default(cuid())
  pemohonId       String
  pemohon         User       @relation("Pemohon", fields: [pemohonId], references: [id], onDelete: Restrict)
  jenisId         String
  jenis           JenisCuti  @relation(fields: [jenisId], references: [id], onDelete: Restrict)
  tglMulai        DateTime
  tglSelesai      DateTime
  jumlahHariKerja Int
  alasan          String
  picPengganti    String?
  kontakSelamaCuti String?
  lampiranPath    String?
  status          String @default("MENUNGGU_ATASAN")
  catatanApprover String?
  approverId      String?
  approver        User?      @relation("ApproverSaatIni", fields: [approverId], references: [id], onDelete: SetNull)
  reminderCount   Int @default(0)
  lastReminderAt  DateTime?
  dieskalasi      Boolean @default(false)
  eskalasiKeId    String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  riwayat AuditLog[]
  notifikasi Notifikasi[]
}

model Kuota {
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jenisId  String
  jenis    JenisCuti @relation(fields: [jenisId], references: [id], onDelete: Cascade)
  tahun    Int
  jatah    Int
  terpakai Int       @default(0)
  @@unique([userId, jenisId, tahun])
}

model Delegasi {
  id         String   @id @default(cuid())
  dariId     String
  dari       User     @relation("DelegasiDari", fields: [dariId], references: [id], onDelete: Cascade)
  keId       String
  ke         User     @relation("DelegasiKe", fields: [keId], references: [id], onDelete: Cascade)
  tglMulai   DateTime
  tglSelesai DateTime
  aktif      Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model AuditLog {
  id          String     @id @default(cuid())
  pengajuanId String?
  pengajuan   Pengajuan? @relation(fields: [pengajuanId], references: [id], onDelete: SetNull)
  laporanId   String?
  laporan     LaporanLapangan? @relation(fields: [laporanId], references: [id], onDelete: SetNull)
  aktorId     String?
  aktor       User?      @relation(fields: [aktorId], references: [id], onDelete: SetNull)
  aksi        String
  dariStatus  String?
  keStatus    String?
  catatan     String?
  createdAt   DateTime   @default(now())
}

model Sesi {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Notifikasi {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  pengajuanId       String?
  pengajuan         Pengajuan?       @relation(fields: [pengajuanId], references: [id], onDelete: SetNull)
  laporanId         String?
  laporan           LaporanLapangan? @relation(fields: [laporanId], references: [id], onDelete: SetNull)
  tipe          String   @default("CUTI")
   kanal             String            @default("APP")
   judul       String
   pesan       String
   dibaca      Boolean    @default(false)
   createdAt   DateTime   @default(now())
}

model PushSubscription {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint      String   @unique
  p256dh        String
  auth          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@unique([userId, endpoint])
}

